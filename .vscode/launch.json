    "version": "0.2.0",
    "configurations": [
        {
            "name": "configure.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/configure.py",
            "cwd": "${env:GMAT_GIT}/depends",
            "console": "integratedTerminal"
        },
        {
            "name": "setup_xerces.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/setup_xerces.py",
            "cwd": "${workspaceFolder}/../gmat-git/depends",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}